    "Sign out in the %@ window to use another account.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous dans la fenêtre %@ pour utiliser un autre compte."
          }
